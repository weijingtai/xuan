import 'package:common/enums/enum_gender.dart';
import 'package:flutter/material.dart';
import 'package:common/enums.dart';
import 'package:common/module.dart';
import 'package:qizhengsiyu/models/divination_model.dart';
import 'package:qizhengsiyu/widgets/common/date_time_picker.dart';
import 'package:qizhengsiyu/widgets/common/gender_selector.dart';

/// 基本信息配置部分
class BasicInfoSection extends StatefulWidget {
  /// 配置类型（命理运势或占卜事情）
  final EnumQueryType configType;

  /// 信息变更回调
  final Function onInfoChanged;

  /// 初始信息
  final dynamic initialInfo;

  const BasicInfoSection({
    Key? key,
    required this.configType,
    required this.onInfoChanged,
    this.initialInfo,
  }) : super(key: key);

  @override
  State<BasicInfoSection> createState() => _BasicInfoSectionState();
}

class _BasicInfoSectionState extends State<BasicInfoSection> {
  late TextEditingController _nameController;
  late TextEditingController _eventSummaryController;
  late TextEditingController _eventDetailController;
  late TextEditingController _beneficiaryNameController;
  late TextEditingController _yearDestinyController;
  late TextEditingController _eightCharactersController;

  Gender? _gender;
  Gender? _questionGender;
  DateTime? _birthTime;

  @override
  void initState() {
    super.initState();

    // 初始化控制器
    _nameController = TextEditingController();
    _eventSummaryController = TextEditingController();
    _eventDetailController = TextEditingController();
    _beneficiaryNameController = TextEditingController();
    _yearDestinyController = TextEditingController();
    _eightCharactersController = TextEditingController();

    // 设置初始值
    _setInitialValues();
  }

  void _setInitialValues() {
    if (widget.initialInfo != null) {
      if (widget.configType == EnumQueryType.destiny) {
        final info = widget.initialInfo as BasicPersonInfo;
        _nameController.text = info.name ?? '';
        _gender = info.gender;
        _birthTime = info.birthTime;
      } else {
        final info = widget.initialInfo as QiZhengSiYuDivination;
        _eventSummaryController.text = info.eventSummary ?? '';
        _eventDetailController.text = info.eventDetail ?? '';
        _beneficiaryNameController.text = info.beneficiaryName ?? '';
        _beneficiaryGender = info.beneficiaryGender;
        _yearDestinyController.text = info.beneficiaryYearDestiny ?? '';
        _eightCharactersController.text = info.eightCharacters ?? '';
      }
    }
  }

  @override
  void dispose() {
    _nameController.dispose();
    _eventSummaryController.dispose();
    _eventDetailController.dispose();
    _beneficiaryNameController.dispose();
    _yearDestinyController.dispose();
    _eightCharactersController.dispose();
    super.dispose();
  }

  void _updateInfo() {
    if (widget.configType == EnumQueryType.destiny) {
      final info = BasicPersonInfo(
        name: _nameController.text.isEmpty ? null : _nameController.text,
        gender: _gender,
        birthTime: _birthTime,
      );
      widget.onInfoChanged(info);
    } else {
      final info = QiZhengSiYuDivination(
        eventSummary: _eventSummaryController.text.isEmpty
            ? null
            : _eventSummaryController.text,
        eventDetail: _eventDetailController.text.isEmpty
            ? null
            : _eventDetailController.text,
        beneficiaryName: _beneficiaryNameController.text.isEmpty
            ? null
            : _beneficiaryNameController.text,
        beneficiaryGender: _beneficiaryGender,
        beneficiaryYearDestiny: _yearDestinyController.text.isEmpty
            ? null
            : _yearDestinyController.text,
        eightCharacters: _eightCharactersController.text.isEmpty
            ? null
            : _eightCharactersController.text,
      );
      widget.onInfoChanged(info);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          '基本信息',
          style: Theme.of(context).textTheme.titleLarge,
        ),
        const SizedBox(height: 16),

        // 根据配置类型显示不同的表单
        widget.configType == EnumQueryType.destiny
            ? _buildDestinyForm()
            : _buildDivinationForm(),
      ],
    );
  }

  /// 构建命理运势表单
  Widget _buildDestinyForm() {
    return Column(
      children: [
        // 姓名（可选）
        TextFormField(
          controller: _nameController,
          decoration: const InputDecoration(
            labelText: '姓名（可选）',
            hintText: '请输入姓名',
          ),
          onChanged: (_) => _updateInfo(),
        ),
        const SizedBox(height: 16),

        // 性别（必选）
        GenderSelector(
          initialValue: _gender,
          onChanged: (value) {
            setState(() {
              _gender = value;
            });
            _updateInfo();
          },
          isRequired: true,
        ),
        const SizedBox(height: 16),

        // 出生时间（必选）
        CustomDateTimePicker(
          labelText: '出生时间（必选）',
          initialValue: _birthTime,
          onChanged: (value) {
            setState(() {
              _birthTime = value;
            });
            _updateInfo();
          },
          validator: (value) {
            if (value == null) {
              return '请选择出生时间';
            }
            return null;
          },
        ),
      ],
    );
  }

  /// 构建占卜事情表单
  Widget _buildDivinationForm() {
    return Column(
      children: [
        // 事情简述（可选）
        TextFormField(
          controller: _eventSummaryController,
          decoration: const InputDecoration(
            labelText: '事情简述（可选）',
            hintText: '请简要描述所占事情',
          ),
          onChanged: (_) => _updateInfo(),
        ),
        const SizedBox(height: 16),

        // 事情详细描述（可选）
        TextFormField(
          controller: _eventDetailController,
          decoration: const InputDecoration(
            labelText: '事情详细描述（可选）',
            hintText: '请详细描述所占事情',
          ),
          maxLines: 3,
          onChanged: (_) => _updateInfo(),
        ),
        const SizedBox(height: 16),

        // 福主名字（可选）
        TextFormField(
          controller: _beneficiaryNameController,
          decoration: const InputDecoration(
            labelText: '求测人名字（可选）',
            hintText: '请输入福主名字',
          ),
          onChanged: (_) => _updateInfo(),
        ),
        const SizedBox(height: 16),

        // 福主性别（必选）
        GenderSelector(
          labelText: '求测人性别（必选）',
          initialValue: _questionGender,
          onChanged: (value) {
            setState(() {
              _questionGender = value;
            });
            _updateInfo();
          },
          isRequired: true,
        ),
        const SizedBox(height: 16),

        // 福主年命（可选）
        TextFormField(
          controller: _yearDestinyController,
          decoration: const InputDecoration(
            labelText: '福主年命（可选）',
            hintText: '请输入福主年命',
          ),
          onChanged: (_) => _updateInfo(),
        ),
        const SizedBox(height: 16),

        // 八字（可选）
        TextFormField(
          controller: _eightCharactersController,
          decoration: const InputDecoration(
            labelText: '八字（可选）',
            hintText: '请输入八字',
          ),
          onChanged: (_) => _updateInfo(),
        ),
      ],
    );
  }
}
