import 'package:flutter/material.dart';
import 'package:qizhengsiyu/models/panel_config.dart';
import 'package:qizhengsiyu/enums/enum_panel_system_type.dart';

/// 星辰选择对话框
class StarSelectionDialog extends StatefulWidget {
  /// 初始选择
  final EnabledStars initialSelection;

  const StarSelectionDialog({
    Key? key,
    required this.initialSelection,
  }) : super(key: key);

  @override
  State<StarSelectionDialog> createState() => _StarSelectionDialogState();
}

class _StarSelectionDialogState extends State<StarSelectionDialog> {
  late EnabledStars _selection;
  late SchoolType _selectedSchool;

  @override
  void initState() {
    super.initState();
    _selection = widget.initialSelection.copy();
    _selectedSchool = SchoolType.qinTang; // 默认琴堂派
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: const Text('选择启用的星辰'),
      content: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // 流派选择（影响罗计五行属性）
            const Text('选择流派（影响罗计五行属性）：'),
            const SizedBox(height: 8),
            SegmentedButton<SchoolType>(
              segments: SchoolType.values.map((type) {
                return ButtonSegment<SchoolType>(
                  value: type,
                  label: Text(type.displayName),
                );
              }).toList(),
              selected: {_selectedSchool},
              onSelectionChanged: (Set<SchoolType> selected) {
                setState(() {
                  _selectedSchool = selected.first;
                });
              },
            ),
            const SizedBox(height: 16),
            const Divider(),
            
            // 星辰选择
            CheckboxListTile(
              title: const Text('日月'),
              subtitle: const Text('太阳、太阴'),
              value: _selection.sunMoon,
              onChanged: (value) {
                if (value != null) {
                  setState(() {
                    _selection.sunMoon = value;
                  });
                }
              },
            ),
            
            CheckboxListTile(
              title: const Text('五行星'),
              subtitle: const Text('金木水火土（金星、木星、水星、火星、土星）'),
              value: _selection.jinGuiWuShu,
              onChanged: (value) {
                if (value!= null) {
                  setState(() {
                    _selection.jinGuiWuShu = value;
                  });
                }
              },
            
        ),
        const SizedBox(height: 16),

        // 时区选择器
        TimezonePicker(
          initialValue: _timezone,
          onChanged: (value) {
            setState(() {
              _timezone = value;
            });
            _updateLocation();
          },
        ),
        const SizedBox(height: 16),

        // 夏令时选项
        SwitchListTile(
          title: const Text('是否有夏令时'),
          value: _hasDaylightSaving,
          onChanged: (value) {
            setState(() {
              _hasDaylightSaving = value;
            });
            _updateLocation();
          },
        ),

        // 真太阳时选项
        SwitchListTile(
          title: const Text('是否使用真太阳时'),
          subtitle: const Text('使用真太阳时会根据经度调整时间'),
          value: _isTrueSolarTime,
          onChanged: (value) {
            setState(() {
              _isTrueSolarTime = value;
            });
            _updateLocation();
          },
        ),
      ],
    );
  }
}