import 'package:flutter/material.dart';
import 'package:qizhengsiyu/enums/enum_panel_system_type.dart';
import 'package:qizhengsiyu/models/panel_config.dart';
import 'package:qizhengsiyu/widgets/common/info_tooltip.dart';
import 'package:qizhengsiyu/widgets/config/star_selection_dialog.dart';
import 'package:qizhengsiyu/widgets/config/chart_order_dialog.dart';
import 'package:qizhengsiyu/widgets/config/shen_sha_config_dialog.dart';

/// 自定义配置部分
class CustomConfigSection extends StatefulWidget {
  /// 配置变更回调
  final Function(CustomConfig) onConfigChanged;

  /// 初始配置
  final CustomConfig? initialConfig;

  const CustomConfigSection({
    Key? key,
    required this.onConfigChanged,
    this.initialConfig,
  }) : super(key: key);

  @override
  State<CustomConfigSection> createState() => _CustomConfigSectionState();
}

class _CustomConfigSectionState extends State<CustomConfigSection> {
  late CustomConfig _config;

  // 星宿制式是否可选（取决于星道制式）
  bool _isStarInnTypeSelectable = true;

  @override
  void initState() {
    super.initState();

    // 初始化配置
    _config = widget.initialConfig ?? CustomConfig();

    // 检查星宿类型是否可选
    _updateStarInnTypeSelectability();
  }

  /// 更新星宿类型是否可选
  void _updateStarInnTypeSelectability() {
    // 黄道制下恒星制只能选择古宿和今宿
    if (_config.coordinateSystem == CoordinateSystem.Ecliptic &&
        _config.starInnSystem == StarInnSystem.Sidereal) {
      _isStarInnTypeSelectable =
          _config.starInnType != StarInnType.AdjustedClassical;

      // 如果当前选择了不可用的选项，则重置为默认值
      if (_config.starInnType == StarInnType.AdjustedClassical) {
        _config.starInnType = StarInnType.Classical;
      }
    } else {
      _isStarInnTypeSelectable = true;
    }
  }

  /// 更新配置并通知父组件
  void _updateConfig() {
    widget.onConfigChanged(_config);
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          '自定义配置',
          style: Theme.of(context).textTheme.titleLarge,
        ),
        const SizedBox(height: 16),

        // 星道制式选择
        _buildCoordinateSystemSelector(),
        const SizedBox(height: 16),

        // 星宿制式选择
        _buildStarInnSystemSelector(),
        const SizedBox(height: 16),

        // 星盘类型选择
        _buildStarInnTypeSelector(),
        const SizedBox(height: 16),

        // 运势选择
        _buildFortuneTypeSelector(),
        const SizedBox(height: 16),

        // 批命提示流派
        _buildSchoolTypeSelector(),
        const SizedBox(height: 16),

        // 安身立命方式
        _buildLifeEstablishmentSelector(),
        const SizedBox(height: 16),

        // 选择启用的星辰
        _buildEnabledStarsSelector(),
        const SizedBox(height: 16),

        // 流派典籍选择
        _buildClassicBookSelector(),
        const SizedBox(height: 16),

        // 化曜系统
        _buildTransformationSystemSelector(),
        const SizedBox(height: 16),

        // 神煞设定和命盘顺序按钮
        _buildActionButtons(),
      ],
    );
  }

  /// 构建星道制式选择器
  Widget _buildCoordinateSystemSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('星道制式：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '黄道制基于地球公转轨道，赤道制基于地球自转轴',
            ),
          ],
        ),
        const SizedBox(height: 8),
        SegmentedButton<CoordinateSystem>(
          segments: const [
            ButtonSegment<CoordinateSystem>(
              value: CoordinateSystem.Ecliptic,
              label: Text('黄道制'),
            ),
            ButtonSegment<CoordinateSystem>(
              value: CoordinateSystem.Equatorial,
              label: Text('赤道制'),
            ),
          ],
          selected: {_config.coordinateSystem},
          onSelectionChanged: (Set<CoordinateSystem> selected) {
            setState(() {
              _config.coordinateSystem = selected.first;
              _updateStarInnTypeSelectability();
            });
            _updateConfig();
          },
        ),
      ],
    );
  }

  /// 构建星宿制式选择器
  Widget _buildStarInnSystemSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('星宿制式：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '回归制基于太阳回归年，恒星制考虑岁差',
            ),
          ],
        ),
        const SizedBox(height: 8),
        SegmentedButton<StarInnSystem>(
          segments: const [
            ButtonSegment<StarInnSystem>(
              value: StarInnSystem.Tropical,
              label: Text('回归制'),
            ),
            ButtonSegment<StarInnSystem>(
              value: StarInnSystem.Sidereal,
              label: Text('恒星制'),
            ),
          ],
          selected: {_config.starInnSystem},
          onSelectionChanged: (Set<StarInnSystem> selected) {
            setState(() {
              _config.starInnSystem = selected.first;

              // 如果切换到恒星制且当前是黄道制，需要检查星宿类型
              _updateStarInnTypeSelectability();

              // 如果是黄道恒星制，显示提示
              if (_config.starInnSystem == StarInnSystem.Sidereal &&
                  _config.coordinateSystem == CoordinateSystem.Ecliptic) {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    content: Text('黄道恒星制即为"推黄道术"'),
                  ),
                );
              }
            });
            _updateConfig();
          },
        ),
      ],
    );
  }

  /// 构建星盘类型选择器
  Widget _buildStarInnTypeSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('星盘类型：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '回归制黄道可选古宿、矫正古宿、今宿；恒星制只能选择古宿、今宿',
            ),
          ],
        ),
        const SizedBox(height: 8),
        SegmentedButton<StarInnType>(
          segments: [
            const ButtonSegment<StarInnType>(
              value: StarInnType.Classical,
              label: Text('古宿'),
            ),
            ButtonSegment<StarInnType>(
              value: StarInnType.AdjustedClassical,
              label: const Text('矫正古宿'),
              enabled: _isStarInnTypeSelectable &&
                  _config.starInnSystem == StarInnSystem.Tropical,
            ),
            const ButtonSegment<StarInnType>(
              value: StarInnType.Mordern,
              label: Text('今宿'),
            ),
          ],
          selected: {_config.starInnType},
          onSelectionChanged: (Set<StarInnType> selected) {
            setState(() {
              _config.starInnType = selected.first;
            });
            _updateConfig();
          },
        ),
      ],
    );
  }

  /// 构建运势选择器
  Widget _buildFortuneTypeSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('运势选择：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '可多选，星盘界面内可动态手动修改',
            ),
          ],
        ),
        const SizedBox(height: 8),
        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: FortuneType.values.map((type) {
            return FilterChip(
              label: Text(type.displayName),
              selected: _config.fortuneTypes.contains(type),
              onSelected: (selected) {
                setState(() {
                  if (selected) {
                    _config.fortuneTypes.add(type);
                  } else {
                    _config.fortuneTypes.remove(type);
                  }
                });
                _updateConfig();
              },
            );
          }).toList(),
        ),
      ],
    );
  }

  /// 构建批命提示流派选择器
  Widget _buildSchoolTypeSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('批命提示流派：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '不同流派对星盘的解读方式有所不同',
            ),
          ],
        ),
        const SizedBox(height: 8),
        SegmentedButton<SchoolType>(
          segments: SchoolType.values.map((type) {
            return ButtonSegment<SchoolType>(
              value: type,
              label: Text(type.displayName),
              icon: Icon(_getSchoolTypeIcon(type)),
            );
          }).toList(),
          selected: {_config.schoolType},
          onSelectionChanged: (Set<SchoolType> selected) {
            setState(() {
              _config.schoolType = selected.first;

              // 根据流派自动设置相关配置
              _autoConfigureBySchool(_config.schoolType);
            });
            _updateConfig();
          },
        ),
      ],
    );
  }

  /// 获取流派对应的图标
  IconData _getSchoolTypeIcon(SchoolType type) {
    switch (type) {
      case SchoolType.qinTang:
        return Icons.music_note;
      case SchoolType.guoLao:
        return Icons.elderly;
      case SchoolType.tianGuan:
        return Icons.star;
      case SchoolType.custom:
        return Icons.settings;
    }
  }

  /// 根据流派自动配置相关设置
  void _autoConfigureBySchool(SchoolType schoolType) {
    switch (schoolType) {
      case SchoolType.qinTang:
        // 琴堂派配置
        _config.bodyPalaceType = BodyPalaceType.moonReverseToYou;
        _config.classicBook = ClassicBook.starStudyDaCheng;
        break;
      case SchoolType.guoLao:
        // 果老派配置
        _config.bodyPalaceType = BodyPalaceType.moonBody;
        _config.classicBook = ClassicBook.guoLaoXingZong;
        break;
      case SchoolType.tianGuan:
        // 天官派配置
        _config.bodyPalaceType = BodyPalaceType.moonBody;
        _config.classicBook = ClassicBook.xingMingZongKuo;
        break;
      case SchoolType.custom:
        // 自定义配置，不做更改
        break;
    }
  }

  /// 构建安身立命方式选择器
  Widget _buildLifeEstablishmentSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text('安身立命方式：'),
        const SizedBox(height: 8),

        // 立命方式
        Row(
          children: [
            const Text('立命：'),
            const SizedBox(width: 16),
            Expanded(
              child: DropdownButton<LifeEstablishmentType>(
                isExpanded: true,
                value: _config.lifeEstablishmentType,
                onChanged: (value) {
                  if (value != null) {
                    setState(() {
                      _config.lifeEstablishmentType = value;
                    });
                    _updateConfig();
                  }
                },
                items: LifeEstablishmentType.values.map((type) {
                  return DropdownMenuItem<LifeEstablishmentType>(
                    value: type,
                    child: Text(type.displayName),
                  );
                }).toList(),
              ),
            ),
          ],
        ),
        const SizedBox(height: 8),

        // 身宫方式
        Row(
          children: [
            const Text('身宫：'),
            const SizedBox(width: 16),
            Expanded(
              child: DropdownButton<BodyPalaceType>(
                isExpanded: true,
                value: _config.bodyPalaceType,
                onChanged: (value) {
                  if (value != null) {
                    setState(() {
                      _config.bodyPalaceType = value;
                    });
                    _updateConfig();
                  }
                },
                items: BodyPalaceType.values.map((type) {
                  String displayText = type.displayName;
                  if (type == BodyPalaceType.moonReverseToYou) {
                    displayText += '（琴堂派）';
                  }
                  return DropdownMenuItem<BodyPalaceType>(
                    value: type,
                    child: Text(displayText),
                  );
                }).toList(),
              ),
            ),
          ],
        ),
      ],
    );
  }

  /// 构建启用星辰选择器
  Widget _buildEnabledStarsSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('选择启用的星辰：'),
            const SizedBox(width: 8),
            TextButton(
              onPressed: _showStarSelectionDialog,
              onPressed: _showStarSelectionDialog,
              child: const Text('选择星辰'),
            ),
          ],
        ),
        const SizedBox(height: 8),

        // 显示已选择的星辰
        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: _buildSelectedStarsChips(),
        ),
      ],
    );
  }

  /// 构建已选择星辰的标签
  List<Widget> _buildSelectedStarsChips() {
    List<Widget> chips = [];

    // 日月
    if (_config.enabledStars.sunMoon) {
      chips.add(const Chip(
        label: Text('日月'),
        avatar: Icon(Icons.wb_sunny_outlined, size: 18),
      ));
    }

    // 五行星
    if (_config.enabledStars.fiveElements) {
      chips.add(const Chip(
        label: Text('金木水火土'),
        avatar: Icon(Icons.auto_awesome, size: 18),
      ));
    }

    // 气孛
    if (_config.enabledStars.qiBo) {
      chips.add(const Chip(
        label: Text('气孛'),
        avatar: Icon(Icons.air, size: 18),
      ));
    }

    // 罗计
    if (_config.enabledStars.luoJi) {
      chips.add(const Chip(
        label: Text('罗计'),
        avatar: Icon(Icons.calculate_outlined, size: 18),
      ));
    }

    // 上升点
    if (_config.enabledStars.ascendant) {
      chips.add(const Chip(
        label: Text('上升点'),
        avatar: Icon(Icons.arrow_upward, size: 18),
      ));
    }

    return chips;
  }

  /// 显示星辰选择对话框
  void _showStarSelectionDialog() async {
    final result = await showDialog<EnabledStars>(
      context: context,
      builder: (context) => StarSelectionDialog(
        initialSelection: _config.enabledStars,
      ),
    );

    if (result != null) {
      setState(() {
        _config.enabledStars = result;
      });
      _updateConfig();
    }
  }

  /// 构建流派典籍选择器
  Widget _buildClassicBookSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('流派典籍选择：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '不同典籍对应不同的星盘制式和历法',
            ),
          ],
        ),
        const SizedBox(height: 8),

        // 典籍选择
        Wrap(
          spacing: 8,
          runSpacing: 12,
          children: ClassicBook.values.map((book) {
            return InkWell(
              onTap: () {
                setState(() {
                  _config.classicBook = book;

                  // 自动设置对应的星盘制式
                  _autoConfigureByClassicBook(book);
                });
                _updateConfig();
              },
              onHover: (isHovering) {
                if (isHovering) {
                  _showClassicBookInfo(book);
                }
              },
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                decoration: BoxDecoration(
                  border: Border.all(
                    color: _config.classicBook == book
                        ? Theme.of(context).colorScheme.primary
                        : Colors.grey,
                    width: _config.classicBook == book ? 2 : 1,
                  ),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Text(
                  book.displayName,
                  style: TextStyle(
                    color: _config.classicBook == book
                        ? Theme.of(context).colorScheme.primary
                        : null,
                    fontWeight: _config.classicBook == book
                        ? FontWeight.bold
                        : FontWeight.normal,
                  ),
                ),
              ),
            );
          }).toList(),
        ),

        // 合参选项
        const SizedBox(height: 12),
        CheckboxListTile(
          title: const Text('合参'),
          subtitle: const Text('综合参考多种典籍'),
          value: _config.useMultipleClassicBooks,
          onChanged: (value) {
            if (value != null) {
              setState(() {
                _config.useMultipleClassicBooks = value;
              });
              _updateConfig();
            }
          },
          controlAffinity: ListTileControlAffinity.leading,
          contentPadding: EdgeInsets.zero,
        ),
      ],
    );
  }

  /// 显示典籍信息
  void _showClassicBookInfo(ClassicBook book) {
    String title = book.displayName;
    String content = '';
    String school = '';
    String calendar = '';

    switch (book) {
      case ClassicBook.guoLaoXingZong:
        school = '果老派';
        content = '《果老星宗》是果老派的重要典籍';
        calendar = '汉书·律历志';
        break;
      case ClassicBook.xingDuZhiNan:
        school = '果老派';
        content = '《星度指南》是果老派的重要典籍';
        calendar = '唐·大衍历';
        break;
      case ClassicBook.xingMingZhengZheng:
        school = '天官派';
        content = '《星命说证》是天官派的重要典籍';
        calendar = '元·授时历';
        break;
      case ClassicBook.xingMingZongKuo:
        school = '天官派';
        content = '《星命总括》是天官派的重要典籍';
        calendar = '元·授时历';
        break;
      case ClassicBook.starStudyDaCheng:
        school = '琴堂派';
        content = '《星学大成》是琴堂派的重要典籍';
        calendar = '宋·天禧历';
        break;
      case ClassicBook.xingPingHuiHai:
        school = '琴堂派';
        content = '《星平会海》是琴堂派的重要典籍';
        calendar = '宋·天禧历';
        break;
      case ClassicBook.zhengShiXingAn:
        school = '琴堂派';
        content = '《郑氏星案》是琴堂派的重要典籍';
        calendar = '宋·天禧历';
        break;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('$title（$school）',
                style: const TextStyle(fontWeight: FontWeight.bold)),
            Text(content),
            Text('使用历法：$calendar'),
          ],
        ),
        duration: const Duration(seconds: 3),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  /// 根据典籍自动配置星盘制式
  void _autoConfigureByClassicBook(ClassicBook book) {
    // 弹窗提醒用户
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('已根据典籍自动调整星盘制式设定'),
        duration: Duration(seconds: 2),
      ),
    );

    // 根据典籍设置对应的星盘制式
    switch (book) {
      case ClassicBook.guoLaoXingZong:
      case ClassicBook.xingDuZhiNan:
        // 果老派典籍
        _config.coordinateSystem = CoordinateSystem.Ecliptic;
        _config.starInnSystem = StarInnSystem.Tropical;
        _config.starInnType = StarInnType.Classical;
        break;
      case ClassicBook.xingMingZhengZheng:
      case ClassicBook.xingMingZongKuo:
        // 天官派典籍
        _config.coordinateSystem = CoordinateSystem.Ecliptic;
        _config.starInnSystem = StarInnSystem.Tropical;
        _config.starInnType = StarInnType.AdjustedClassical;
        break;
      case ClassicBook.starStudyDaCheng:
      case ClassicBook.xingPingHuiHai:
      case ClassicBook.zhengShiXingAn:
        // 琴堂派典籍
        _config.coordinateSystem = CoordinateSystem.Equatorial;
        _config.starInnSystem = StarInnSystem.Tropical;
        _config.starInnType = StarInnType.Classical;
        break;
    }

    // 更新星宿类型可选性
    _updateStarInnTypeSelectability();
  }

  /// 构建化曜系统选择器
  Widget _buildTransformationSystemSelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            const Text('化曜系统：'),
            const SizedBox(width: 8),
            InfoTooltip(
              message: '果老化曜又称"库管星化曜"，可双选（"同参"）',
            ),
          ],
        ),
        const SizedBox(height: 8),

        // 化曜系统选择
        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: TransformationSystem.values.map((system) {
            return FilterChip(
              label: Text(system.displayName),
              selected: _config.transformationSystems.contains(system),
              onSelected: (selected) {
                setState(() {
                  if (selected) {
                    _config.transformationSystems.add(system);
                  } else {
                    _config.transformationSystems.remove(system);
                  }
                });
                _updateConfig();
              },
            );
          }).toList(),
        ),
      ],
    );
  }

  /// 构建操作按钮
  Widget _buildActionButtons() {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
      children: [
        // 神煞设定按钮
        ElevatedButton.icon(
          onPressed: _showShenShaConfigDialog,
          icon: const Icon(Icons.settings),
          label: const Text('神煞设定'),
        ),

        // 命盘顺序按钮
        ElevatedButton.icon(
          onPressed: _showChartOrderDialog,
          icon: const Icon(Icons.reorder),
          label: const Text('命盘顺序'),
        ),
      ],
    );
  }

  /// 显示神煞设定对话框
  void _showShenShaConfigDialog() async {
    final result = await showDialog<ShenShaConfig>(
      context: context,
      builder: (context) => ShenShaConfigDialog(
        initialConfig: _config.shenShaConfig,
        schoolType: _config.schoolType,
      ),
    );

    if (result != null) {
      setState(() {
        _config.shenShaConfig = result;
      });
      _updateConfig();
    }
  }

  /// 显示命盘顺序对话框
  void _showChartOrderDialog() async {
    final result = await showDialog<List<String>>(
      context: context,
      builder: (context) => ChartOrderDialog(
        initialOrder: _config.chartOrder,
      ),
    );

    if (result != null) {
      setState(() {
        _config.chartOrder = result;
      });
      _updateConfig();
    }
  }
}
