import 'package:flutter/foundation.dart';
import 'package:qizhengsiyu/enums/enum_panel_system_type.dart';
import 'package:qizhengsiyu/models/panel_config.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'dart:convert';

/// 命盘配置视图模型
///
/// 负责处理命盘配置的业务逻辑，并通过ValueNotifier通知UI更新
class PanelConfigViewModel {
  // 配置对象
  late PanelConfig _config;
  PanelConfig get config => _config;

  // 各部分配置的ValueNotifier
  late final ValueNotifier<ConfigType> configTypeNotifier;
  late final ValueNotifier<BasicInfo> basicInfoNotifier;
  late final ValueNotifier<LocationInfo> locationNotifier;
  late final ValueNotifier<CustomConfig> customConfigNotifier;

  // 构造函数
  PanelConfigViewModel(PanelConfig? initialConfig) {
    _config = initialConfig ?? PanelConfig();

    // 初始化ValueNotifier
    configTypeNotifier = ValueNotifier(_config.configType);
    basicInfoNotifier = ValueNotifier(_config.basicInfo);
    locationNotifier = ValueNotifier(_config.location);
    customConfigNotifier = ValueNotifier(_config.customConfig);

    // 如果没有初始配置，尝试从本地加载
    if (initialConfig == null) {
      _loadConfigFromLocal();
    }
  }

  // 释放资源
  void dispose() {
    configTypeNotifier.dispose();
    basicInfoNotifier.dispose();
    locationNotifier.dispose();
    customConfigNotifier.dispose();
  }

  // 更新配置类型
  void updateConfigType(ConfigType configType) {
    _config.configType = configType;
    configTypeNotifier.value = configType;
  }

  // 更新基本信息
  void updateBasicInfo(BasicInfo basicInfo) {
    _config.basicInfo = basicInfo;
    basicInfoNotifier.value = basicInfo;
  }

  // 更新位置信息
  void updateLocation(LocationInfo location) {
    _config.location = location;
    locationNotifier.value = location;
  }

  // 更新自定义配置
  void updateCustomConfig(CustomConfig customConfig) {
    _config.customConfig = customConfig;
    customConfigNotifier.value = customConfig;
  }

  // 从本地存储加载配置
  Future<void> _loadConfigFromLocal() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final String? configJson = prefs.getString('qi_zheng_si_yu_config');

      if (configJson != null) {
        final Map<String, dynamic> configMap = jsonDecode(configJson);
        _config = PanelConfig.fromJson(configMap);

        // 更新所有ValueNotifier
        configTypeNotifier.value = _config.configType;
        basicInfoNotifier.value = _config.basicInfo;
        locationNotifier.value = _config.location;
        customConfigNotifier.value = _config.customConfig;
      }
    } catch (e) {
      print('加载配置失败: $e');
    }
  }

  // 保存配置到本地存储
  Future<void> saveConfigToLocal() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final String configJson = jsonEncode(_config.toJson());
      await prefs.setString('qi_zheng_si_yu_config', configJson);
    } catch (e) {
      print('保存配置失败: $e');
    }
  }
}
