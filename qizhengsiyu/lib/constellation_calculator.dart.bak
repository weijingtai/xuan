  static List<StarInnPosition> _generateStarInnSequence(
      StarInnDegree dynamicStart, List<StarInnDegree> baseSequence) {
    final tmpAppendToTail = <StarInnDegree>[];
    final newSequence = <StarInnDegree>[];

    for (final constellation in baseSequence) {
      if (constellation.name != dynamicStart.name) {
        if (newSequence.isEmpty) {
          tmpAppendToTail.add(StarInnDegree(
            name: constellation.name,
            degree: constellation.degree,
          ));
        } else {
          newSequence.add(StarInnDegree(
            name: constellation.name,
            degree: constellation.degree,
          ));
        }
      } else {
        if (dynamicStart.degree > constellation.degree) {
          // // print(
          //     '警告：${dynamicStart.name}宿偏移量${dynamicStart.degree}超过该宿总度数${constellation.degree}');
        } else {
          tmpAppendToTail.add(StarInnDegree(
            name: constellation.name,
            degree: constellation.degree,
          ));
          newSequence.add(StarInnDegree(
            name: dynamicStart.name,
            degree: constellation.degree - dynamicStart.degree,
          ));
        }
      }
    }

    newSequence.addAll(tmpAppendToTail);

    double currentAngle = 0;
    final newSequenceWithStartEnd = <StarInnPosition>[];

    for (final item in newSequence) {
      newSequenceWithStartEnd.add(StarInnPosition(
        name: item.name,
        degree: item.degree,
        startAtDegree: currentAngle,
        endAtDegree: currentAngle + item.degree,
      ));
      currentAngle += item.degree;
    }

    return newSequenceWithStartEnd;
  }

  static List<GongPosition> _generateGongSequence(
      GongDegree dynamicStart, List<GongDegree> baseSequence) {
    final tmpAppendToTail = <GongDegree>[];
    final newSequence = <GongDegree>[];

    for (final gong in baseSequence) {
      if (gong.name != dynamicStart.name) {
        if (newSequence.isEmpty) {
          tmpAppendToTail.add(GongDegree(
            name: gong.name,
            degree: gong.degree,
          ));
        } else {
          newSequence.add(GongDegree(
            name: gong.name,
            degree: gong.degree,
          ));
        }
      } else {
        if (dynamicStart.degree > gong.degree) {
          // // print(
          //     '警告：${dynamicStart.name}宿偏移量${dynamicStart.degree}超过该宿总度数${constellation.degree}');
        } else {
          tmpAppendToTail.add(GongDegree(
            name: gong.name,
            degree: gong.degree,
          ));
          newSequence.add(GongDegree(
            name: gong.name,
            degree: gong.degree - dynamicStart.degree,
          ));
        }
      }
    }

    newSequence.addAll(tmpAppendToTail);

    double currentAngle = 0;
    final newSequenceWithStartEnd = <GongPosition>[];

    for (final item in newSequence) {
      newSequenceWithStartEnd.add(GongPosition(
        name: item.name,
        degree: item.degree,
        startAtDegree: currentAngle,
        endAtDegree: currentAngle + item.degree,
      ));
      currentAngle += item.degree;
    }

    return newSequenceWithStartEnd;
  }

  static StarInnDegree _findConstellation(double targetDegree,
      StarInnDegree dynamicStart, List<StarInnDegree> baseSequence) {
    final adjustedSequence =
        _generateStarInnSequence(dynamicStart, baseSequence);

    for (int index = 0; index < adjustedSequence.length; index++) {
      final StarInnPosition item = adjustedSequence[index];
      if (item.startAtDegree <= targetDegree &&
          item.endAtDegree >= targetDegree) {
        if (index == 0 &&
            item.name == adjustedSequence.first.name &&
            item.name == adjustedSequence.last.name) {
          return StarInnDegree(
            name: item.name,
            degree: targetDegree + adjustedSequence.last.degree,
          );
        } else {
          return StarInnDegree(
            name: item.name,
            degree: targetDegree - item.startAtDegree,
          );
        }
      }
    }

    throw Exception('未找到对应的星座');
  }

  static GongDegree _findGong(double targetDegree,
      GongDegree dynamicStart, List<GongDegree> gongSequence) {
    final adjustedSequence = _generateGongSequence(
      dynamicStart,
      gongSequence,
    );

    for (int index = 0; index < adjustedSequence.length; index++) {
      final item = adjustedSequence[index];
      if (item.startAtDegree <= targetDegree && item.endAtDegree >= targetDegree) {
        if (index == 0 &&
            item.name == adjustedSequence.first.name&&
            item.name == adjustedSequence.last.name{
          return GongDegree(
            name: item.name,
            degree: targetDegree - item.startAtDegree + adjustedSequence.last.degree,
          );
        } else {
          return GongDegree(
            name: item.name,
            degree:targetDegree - item.startAtDegree
          );
        }
      }
    }

    throw Exception('未找到对应的宫位');
  }

  static StarEnterInfo starEnterInfo(
    double starAngle,
    StarInnDegree starInnZeroPoint,
    GongDegree gongZeroPoint,
    List<GongDegree> gongDegreeSeq,
    List<StarInnDegree> starInnSeq,
  ) {
    final starInn = _findConstellation(starAngle, starInnZeroPoint, starInnSeq);
    final gong = _findGong(starAngle, gongZeroPoint, baseGong);

    // 保留三位小数
    final roundedStarInnDegree =
        Decimal.parse(starInn.degree.toString()).round(scale: 3).toDouble();
    final roundedGongDegree =
        Decimal.parse(gong.degree.toString()).round(scale: 3).toDouble();

    return EnteredInfo(
      originalStar: 
      starInn: starInn
      gong: gong
    );
  }
