graph TB
    subgraph "算法编译器核心架构"
        A[AlgorithmCompiler] --> B[ConfigurationEngine]
        A --> C[AtomicOperationRegistry]
        A --> D[ExecutionEngine]
        A --> E[CacheManager]
        
        B --> F[JSONConfigLoader]
        B --> G[VersionManager]
        
        C --> H[InputDecomposition]
        C --> I[CoreTransformation]
        C --> J[CompositionConstruction]
        C --> K[AggregationCalculation]
        C --> L[FlowControl]
        C --> M[ValidationGeneration]
        
        D --> N[SyncExecutor]
        D --> O[ErrorHandler]
        
        E --> P[ResultCache]
        E --> Q[RecoveryManager]
    end
    
    subgraph "现有系统集成"
        R[CalculationStrategy] --> A
        S[现有算法实现] --> R
    end
    
    subgraph "配置存储"
        T[JSON配置文件] --> F
        U[版本控制] --> G
    end