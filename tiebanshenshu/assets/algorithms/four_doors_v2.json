{
  "name": "四门法V2-原子化实现",
  "version": "1.0.0",
  "description": "使用原子操作流实现的四门法V2。",
  "createdAt": "2025-08-17T22:01:00.000Z",
  "updatedAt": "2025-08-17T22:01:00.000Z",
  "globalConfig": {
    "four_doors_v2_config": {
      "evenNumberConfig": { "numberOperationStrategy": "mode", "factorNumber": 8, "guaConversionStrategy": "toHouTian" },
      "oddNumberConfig": { "numberOperationStrategy": "mode", "factorNumber": 9, "guaConversionStrategy": "toXianTian" },
      "isOddAsTopGua": true,
      "ganToNumberStrategy": "ganZhiFlatedNumber",
      "zhiToNumberStrategy": "ganZhiFlatedNumber",
      "firstGuaType": "互",
      "secondGuaStrategy": { "needExchange": false, "needCuoGua": false, "guaType": "本", "baseGuaSource": "first", "needVariation": true },
      "thirdGuaStrategy": { "needExchange": false, "needCuoGua": false, "guaType": "互", "baseGuaSource": "first" },
      "fourthGuaStrategy": { "needExchange": false, "needCuoGua": false, "guaType": "互", "baseGuaSource": "second" }
    }
  },
  "steps": [
    {
      "id": "generate_first_four_gua",
      "name": "生成前四卦",
      "operationId": "generate_four_gua",
      "inputs": {
        "fourZhu": "input.fourZhu",
        "threeYuan": "input.threeYuan",
        "gender": "input.gender",
        "config": "config.four_doors_v2_config"
      },
      "outputs": {
        "fourGuaList": "intermediate.first_four_gua",
        "isYangGanYear": "intermediate.is_yang"
      }
    },
    {
      "id": "calculate_secret_numbers_loop",
      "name": "计算秘数列表",
      "operationId": "loop",
      "inputs": {
        "items": "intermediate.first_four_gua",
        "operation": {
          "operationId": "gua_to_ganzhi",
          "inputs": {
            "gua": "{{currentItem}}",
            "isYang": "{{intermediate.is_yang}}"
          }
        }
      },
      "outputs": { "results": "intermediate.secret_ganzhi_pairs" }
    },
    {
      "id": "calculate_xiantian_numbers_loop",
      "name": "计算先天数列表",
      "operationId": "loop",
      "inputs": {
        "items": "intermediate.first_four_gua",
        "operation": { "operationId": "placeholder_for_xiantian_logic" }
      },
      "outputs": { "results": "intermediate.xiantian_numbers" }
    },
    {
      "id": "calculate_final_tiaowen",
      "name": "计算最终条文",
      "operationId": "calculate_four_doors_tiaowen",
      "inputs": {
        "xiantianNumbers": "intermediate.xiantian_numbers",
        "secretNumbers": "intermediate.secret_ganzhi_pairs"
      },
      "outputs": {
        "tiaowenList": "output.final_tiaowen_list"
      }
    }
  ]
}
