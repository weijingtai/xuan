{
  "name": "皇极取数法一-原子化实现",
  "version": "1.0.0",
  "description": "使用原子操作流实现的皇极取数法一。",
  "createdAt": "2025-08-17T22:15:00.000Z",
  "updatedAt": "2025-08-17T22:15:00.000Z",
  "steps": [
    {
      "id": "get_four_zhu",
      "name": "获取四柱",
      "operationId": "field_extraction",
      "inputs": { "data": "input.birthInfo", "fields": ["fourZhu"] },
      "outputs": { "extracted_fields": "intermediate.four_zhu_map" }
    },
    {
      "id": "calc_yuanhui",
      "name": "计算元会数",
      "operationId": "calculate_yuanhui_number",
      "inputs": { "fourZhu": "{{intermediate.four_zhu_map.fourZhu}}" },
      "outputs": { "yuanhuiNumber": "intermediate.yuanhui_number" }
    },
    {
      "id": "get_year_gan_taixuan",
      "name": "获取年干太玄数",
      "operationId": "field_extraction",
      "inputs": { "data": "{{intermediate.four_zhu_map.fourZhu}}", "fields": ["yearGanTaixuanNum"] },
      "outputs": { "extracted_fields": "intermediate.year_gan_taixuan_map" }
    },
    {
      "id": "calc_primary_base_mult",
      "name": "计算主要基础数-乘法部分",
      "operationId": "math_calculation",
      "inputs": {
        "operands": ["{{intermediate.year_gan_taixuan_map.yearGanTaixuanNum}}", 1000],
        "operation": "multiply"
      },
      "outputs": { "result": "intermediate.primary_base_mult_result" }
    },
    {
      "id": "calc_primary_base_add",
      "name": "计算主要基础数-加法部分",
      "operationId": "math_calculation",
      "inputs": {
        "operands": ["{{intermediate.yuanhui_number}}", "{{intermediate.primary_base_mult_result}}"],
        "operation": "add"
      },
      "outputs": { "result": "intermediate.primary_base_number" }
    },
    {
      "id": "normalize_primary_base",
      "name": "标准化主要基础数",
      "operationId": "conditional",
      "inputs": {
        "condition": { "operator": ">", "left": "{{intermediate.primary_base_number}}", "right": 13000 },
        "true_value": "{{intermediate.primary_base_number}} - 12000",
        "false_value": "{{intermediate.primary_base_number}}"
      },
      "outputs": { "result": "intermediate.primary_base_final" }
    },
    {
      "id": "get_month_gan_taixuan",
      "name": "获取月干太玄数",
      "operationId": "field_extraction",
      "inputs": { "data": "{{intermediate.four_zhu_map.fourZhu}}", "fields": ["monthGanTaixuanNum"] },
      "outputs": { "extracted_fields": "intermediate.month_gan_taixuan_map" }
    },
    {
      "id": "calc_tiaowen1_mult",
      "name": "计算条文1-乘法部分",
      "operationId": "math_calculation",
      "inputs": {
        "operands": ["{{intermediate.month_gan_taixuan_map.monthGanTaixuanNum}}", 100],
        "operation": "multiply"
      },
      "outputs": { "result": "intermediate.tiaowen1_mult_result" }
    },
    {
      "id": "calc_tiaowen1_add",
      "name": "计算条文1-加法部分",
      "operationId": "math_calculation",
      "inputs": {
        "operands": ["{{intermediate.primary_base_final}}", "{{intermediate.tiaowen1_mult_result}}"],
        "operation": "add"
      },
      "outputs": { "result": "output.tiaowen1" }
    }
  ]
}
