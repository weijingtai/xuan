  @override
  void initState() {
    super.initState();

    animationController = AnimationController(
      duration: Duration(seconds: 2),
      vsync: this,
    );

    animation = Tween(begin: -1.0, end: 0.0).animate(CurvedAnimation(
        parent: animationController, curve: Curves.fastOutSlowIn));
    animationController.forward();

    dateTimeValueNotifier.addListener((){
      if (dateTimeValueNotifier.value != null){
        shiJiaZhuanPanQiMenValueNotifier.value = create(dateTimeValueNotifier.value!);
      }else{
        if (shiJiaZhuanPanQiMenValueNotifier.value != null){
          shiJiaZhuanPanQiMenValueNotifier.value = null;
        }
      }
    });
    shiJiaZhuanPanQiMenValueNotifier.addListener((){
      if (shiJiaZhuanPanQiMenValueNotifier.value != null){
        guaGongMapperNotifier.value = Map.fromEntries(HouTianGua.values.map((g)=>MapEntry(g, buildEachGong(g,shiJiaZhuanPanQiMenValueNotifier.value!))));
      }
    });
    // WidgetsBinding.instance.addPostFrameCallback((_) {
    //   setState(() {
    //     final RenderBox renderPan = panKey.currentContext!.findRenderObject() as RenderBox;
    //     panOffset = renderPan.localToGlobal(Offset(0, 0));
    //     // start = _getCenter(panKey);
    //   });
    // });


  }

  ShiJiaZhuanPanQiMen create(DateTime panDatetime){
    // DateTime panDatetime = DateFormat("yyyy-MM-dd HH:mm:ss").parse("2017-11-1 13:46:00");
    ShiJiaQiMenJuCalculator calculator = ChaiBuCalculator(dateTime:panDatetime);
    ShiJiaJu shiJiaJu = calculator.calculate();
    var shiJiaQiMen = ShiJiaZhuanPanQiMen(
      panDateTime:panDatetime,
      shiJiaJu:shiJiaJu,
      settings:PanArrangeSettings(
        arrangeType: ArrangeType.CHAI_BU,
        jiGong:CenterGongJiGong.ONLY_KUN_GONG,
        starMonthTokenType:MonthTokenTypeEnum.ZHU_QI_NA_GUA,
        starFourWeiGongType:GongTypeEnum.YIN_YANG_DUN,
        doorFourWeiGongType:GongTypeEnum.GONG_GUA,
        godWithGongTypeEnum:GodWithGongTypeEnum.DI_PAN_GAN_NA_GUA,
        ganGongType: GanGongTypeEnum.WANG_MU,
      )

    );
    return shiJiaQiMen;
  }


