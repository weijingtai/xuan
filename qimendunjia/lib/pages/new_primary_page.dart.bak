class ThreeArrowClipper extends CustomClipper<Rect> {
  @override
  Rect getClip(Size size) {
    double width = size.width * 0.25;
    double heigth = size.height * 0.20;
    return Rect.fromLTWH(width, heigth, size.width - width * 2, size.height-heigth);
    // Adjust the values to define your desired rectangle
  }

  @override
  bool shouldReclip(CustomClipper<Rect> oldClipper) =>false;
}
class TwoArrowClipper extends CustomClipper<Rect> {
  @override
  Rect getClip(Size size) {
    double width = size.width * 0.3;
    double heigth = size.height * 0.20;
    return Rect.fromLTWH(width, heigth, size.width - width * 2, size.height-heigth * 2.5);
    // Adjust the values to define your desired rectangle
  }

  @override
  bool shouldReclip(CustomClipper<Rect> oldClipper) =>false;
}