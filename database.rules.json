{
  "rules": {
    ".read": false,
    ".write": false,

    "public": {
      "$module": {
        "$collection": {
          "$entityId": {
            ".read": "auth != null",
            ".write": false
          }
        }
      }
    },

    "identity_map": {
      "$baasUid": {
        ".read": "auth != null && auth.uid === $baasUid",
        ".write": "auth != null && auth.uid === $baasUid && newData.exists() && (!data.exists() || data.child('appUserId').val() === newData.child('appUserId').val())",

        "appUserId": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },
        "providerType": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "schemaVersion": {
          ".validate": "newData.isNumber()"
        },

        "$other": { ".validate": false }
      }
    },

    "users": {
      "$appUserId": {
        ".read": "auth != null && root.child('identity_map').child(auth.uid).child('appUserId').val() === $appUserId",
        ".write": "auth != null && root.child('identity_map').child(auth.uid).child('appUserId').val() === $appUserId"
      }
    }
  }
}