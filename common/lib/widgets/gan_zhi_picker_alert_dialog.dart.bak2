import 'package:common/enums/enum_di_zhi.dart';
import 'package:common/enums/enum_jia_zi.dart';
import 'package:common/enums/enum_tian_gan.dart';
import 'package:flutter/material.dart';

// 选择器弹窗
Future<JiaZi?> showJiaZiPicker(BuildContext context) {
  return showDialog<JiaZi>(
    context: context,
    builder: (context) => const JiaZiPickerDialog(),
  );
}

class JiaZiPickerDialog extends StatefulWidget {
  const JiaZiPickerDialog({super.key});

  @override
  State<JiaZiPickerDialog> createState() => _JiaZiPickerDialogState();
}

class _JiaZiPickerDialogState extends State<JiaZiPickerDialog> {
  TianGan? _selectedGan;
  DiZhi? _selectedZhi;
  JiaZi? _selectedJiaZi;
  final List<JiaZi> _allJiaZi = JiaZi.values.toList();

  // 获取筛选后的列表
  List<JiaZi> get _filteredList {
    return _allJiaZi.where((jz) {
      final ganMatch = _selectedGan == null || jz.tianGan == _selectedGan;
      final zhiMatch = _selectedZhi == null || jz.diZhi == _selectedZhi;
      return ganMatch && zhiMatch;
    }).toList();
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: const Text('选择干支'),
      content: SizedBox(
        width: double.maxFinite,
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            // 天干筛选器
            _buildGanFilter(),
            const SizedBox(height: 12),
            // 地支筛选器
            _buildZhiFilter(),
            const SizedBox(height: 20),
            // 六十甲子列表
            _buildJiaZiList(),
          ],
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('取消'),
        ),
        TextButton(
          onPressed: _selectedJiaZi == null
              ? null
              : () => Navigator.pop(context, _selectedJiaZi),
          child: const Text('确认'),
        ),
      ],
    );
  }

  // 天干筛选组件
  Widget _buildGanFilter() {
    return Wrap(
      spacing: 8,
      runSpacing: 8,
      children: TianGan.values.map((gan) {
        return ChoiceChip(
          label: Text(gan.name),
          selected: _selectedGan == gan,
          onSelected: (selected) => setState(() {
            _selectedGan = selected ? gan : null;
            // 如果当前选中的甲子不符合筛选条件，则清空选择
            if (_selectedJiaZi != null &&
                _selectedJiaZi!.tianGan != _selectedGan) {
              _selectedJiaZi = null;
            }
          }),
        );
      }).toList(),
    );
  }

  // 地支筛选组件
  Widget _buildZhiFilter() {
    return Wrap(
      spacing: 8,
      runSpacing: 8,
      children: DiZhi.values.map((zhi) {
        return ChoiceChip(
          label: Text(zhi.name),
          selected: _selectedZhi == zhi,
          onSelected: (selected) => setState(() {
            _selectedZhi = selected ? zhi : null;
            // 如果当前选中的甲子不符合筛选条件，则清空选择
            if (_selectedJiaZi != null &&
                _selectedJiaZi!.diZhi != _selectedZhi) {
              _selectedJiaZi = null;
            }
          }),
        );
      }).toList(),
    );
  }

  // 六十甲子列表
  Widget _buildJiaZiList() {
    final filteredJiaZi = _filteredList;

    if (filteredJiaZi.isEmpty) {
      return const Padding(
        padding: EdgeInsets.symmetric(vertical: 20),
        child: Text('没有符合条件的干支组合'),
      );
    }

    return Container(
      height: 200,
      decoration: BoxDecoration(
        border: Border.all(color: Colors.grey.shade300),
        borderRadius: BorderRadius.circular(8),
      ),
      child: GridView.builder(
        padding: const EdgeInsets.all(8),
        gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: 5,
          childAspectRatio: 1.5,
          crossAxisSpacing: 8,
          mainAxisSpacing: 8,
        ),
        itemCount: filteredJiaZi.length,
        itemBuilder: (context, index) {
          final jz = filteredJiaZi[index];
          final isSelected = _selectedJiaZi == jz;

          return InkWell(
            onTap: () => setState(() {
              _selectedJiaZi = jz;
              _selectedGan = jz.tianGan;
              _selectedZhi = jz.diZhi;
            }),
            borderRadius: BorderRadius.circular(4),
            child: Container(
              decoration: BoxDecoration(
                color: isSelected ? Colors.blue.shade100 : Colors.grey.shade100,
                borderRadius: BorderRadius.circular(4),
                border: Border.all(
                  color: isSelected ? Colors.blue : Colors.grey.shade300,
                ),
              ),
              alignment: Alignment.center,
              child: Text(
                jz.name,
                style: TextStyle(
                  color: isSelected ? Colors.blue.shade800 : Colors.black87,
                  fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}
