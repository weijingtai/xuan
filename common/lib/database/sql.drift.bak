-- 启用 WAL 模式，提升并发性能
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;

-- 表：t_query
-- 存储查询相关信息，包括查询基本信息、查询类型、技能、日期时间等
CREATE TABLE t_query (
    -- 使用 UUID 作为主键，SQLite 3.32.0+ 支持
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 查询创建的日期时间
    created_at DATETIME NOT NULL,
    -- 查询最后更新的日期时间
    last_updated_at DATETIME NOT NULL,
    -- 若查询被删除，记录删除的日期时间，为空表示未删除
    deleted_at DATETIME,
    -- 关联 t_query_type 表的 UUID，指定查询所属类型
    query_type_uuid BLOB NOT NULL,
    -- 关联 t_skill 表的 UUID，指定查询使用的技能
    skill_uuid BLOB NOT NULL,
    -- 关联 t_query_datetime 表的 UUID，指定查询的日期时间
    query_datetime_uuid BLOB NOT NULL,
    -- 查询的问题
    query_question TEXT,
    -- 查询的描述
    query_description TEXT,
    -- 求测人的 UUID，可选字段
    seeker_uuid BLOB,
    -- 标识占测是否使用卦师的位置
    is_using_seer_location BOOLEAN CHECK(is_using_seer_location IN (0, 1)),
    -- 外键约束，确保 query_type_uuid 存在于 t_query_type 表中
    FOREIGN KEY (query_type_uuid) REFERENCES t_query_type(uuid),
    -- 外键约束，确保 skill_uuid 存在于 t_skill 表中
    FOREIGN KEY (skill_uuid) REFERENCES t_skill(uuid),
    -- 外键约束，确保 query_datetime_uuid 存在于 t_query_datetime 表中
    FOREIGN KEY (query_datetime_uuid) REFERENCES t_query_datetime(uuid),
    -- 外键约束，确保 seeker_uuid 存在于 t_seeker 表中
    FOREIGN KEY (seeker_uuid) REFERENCES t_seeker(uuid)
);

-- 为常用查询组合创建覆盖索引
CREATE INDEX idx_query_type_time ON t_query(query_type_uuid, created_at);
-- 对高频查询字段建立索引
CREATE INDEX idx_query_created ON t_query(created_at);

-- 表：t_skill
-- 存储技能相关信息，如技能名称、描述、开放状态等
CREATE TABLE t_skill (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 技能最后更新的日期时间
    created_at DATETIME NOT NULL,
    last_updated_at DATETIME NOT NULL,
    -- 若技能被删除，记录删除的日期时间，为空表示未删除
    deleted_at DATETIME,
    -- 标识技能是否开放使用
    is_available BOOLEAN CHECK(is_open IN (0, 1)),
    -- 技能的名称
    name TEXT NOT NULL,
    -- 技能的描述
    descriptions TEXT
);

-- 表：t_combined_query
-- 存储多查询关联信息，用于多盘同参等情况
CREATE TABLE t_combined_query (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 关联 t_query 表的 UUID，表示主查询
    query_uuid BLOB NOT NULL,
    -- 关联 t_query 表的 UUID，表示关联的其他查询
    other_uuid BLOB NOT NULL,
    -- 记录创建的日期时间
    created_at DATETIME NOT NULL,
    -- 若记录被删除，记录删除的日期时间，为空表示未删除
    deleted_at DATETIME,
    -- 组合查询的类型，通过外键引用字典表
    combined_type TEXT,
    -- 外键约束，确保 query_uuid 存在于 t_query 表中
    FOREIGN KEY (query_uuid) REFERENCES t_query(uuid),
    -- 外键约束，确保 other_uuid 存在于 t_query 表中
    FOREIGN KEY (other_uuid) REFERENCES t_query(uuid),
    -- 外键约束，确保 combined_type 存在于 dict_combined_type 表中
    FOREIGN KEY (combined_type) REFERENCES dict_combined_type(code)
);

-- 创建组合查询类型字典表
CREATE TABLE t_dict_combined_type (
    code TEXT PRIMARY KEY,
    name TEXT
);
INSERT INTO dict_combined_type VALUES
    ('同参','多盘同参'),('合盘','命理合盘'),('印证','结果印证'),('运筹','策略运筹'),('矫正','数据矫正');

-- 表：t_query_type
-- 此表用于存储查询类型的相关信息
CREATE TABLE t_query_type (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 记录最后更新的时间
    last_updated_at DATETIME NOT NULL,
    -- 若该查询类型被删除，记录删除的时间，为空则表示未删除
    deleted_at DATETIME,
    -- 标识是否隐藏该查询类型
    hidden_at DATETIME,
    -- 查询类型的名称
    query_type_name TEXT,
    -- 标识是否为用户自定义，为 false 时不能够进行修改
    is_customized BOOLEAN CHECK(is_customized IN (0, 1)),
    -- 标识是否开放当前功能
    is_open BOOLEAN CHECK(is_open IN (0, 1)),
    -- 反范式化设计，直接存储子类型 JSON 数组
    sub_types TEXT
);

-- 表：t_query_datetime
-- 此表用于存储查询的日期时间相关信息，保留核心字段
CREATE TABLE t_query_datetime (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 记录创建的时间
    created_at DATETIME NOT NULL,
    -- 记录最后更新的时间
    last_updated_at DATETIME  NOT NULL,
    -- 若该记录被删除，记录删除的时间，为空则表示未删除
    deleted_at DATETIME,
    -- 日期时间的类型，如标准时间、移除夏令时等
    datetime_type TEXT,
    -- 标识是否为夏令时
    is_dst BOOLEAN CHECK(is_dst IN (0, 1)),
    -- 时区的字符串表示
    timezone_str TEXT,
    -- 位置信息，使用 JSON 类型存储
    location TEXT,
    -- 小时调整值，改用 BOOLEAN 类型
    hour_adjusted BOOLEAN DEFAULT 0,
    -- 关联 t_query 表的 UUID，用于关联查询信息
    t_query_uuid BLOB NOT NULL,
    -- 外键约束，确保 t_query_uuid 存在于 t_query 表中，并设置级联删除
    FOREIGN KEY (t_query_uuid) REFERENCES t_query(uuid) ON DELETE CASCADE
);

-- 表：t_seeker
-- 此表用于存储求测人的相关信息，包括基本信息、出生信息和当前位置信息
-- 使用 SQLCipher 加密表
PRAGMA key = 'encryption-key';
CREATE TABLE t_seeker (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 求测人的用户名
    username TEXT,
    -- 求测人的昵称备注
    nickname TEXT,
    -- 求测人的出生时间
    birth_datetime DATETIME,
    -- 求测人的出生八字
    eight_chars TEXT,
    -- 求测人的出生地
    birth_location TEXT,
    -- 求测人出生地的经度，改用 DECIMAL 类型
    birth_lng REAL,
    -- 求测人出生地的纬度，改用 DECIMAL 类型
    birth_lat REAL,
    -- 求测人当前所在地
    current_location TEXT,
    -- 求测人当前所在的经度，改用 DECIMAL 类型
    current_lng REAL,
    -- 求测人当前所在的纬度，改用 DECIMAL 类型
    current_lat REAL
);

-- 表：t_sub_query_type
-- 此表用于存储子查询类型的相关信息
CREATE TABLE t_sub_query_type (
    -- 使用 UUID 作为主键
    uuid BLOB PRIMARY KEY DEFAULT (hex(randomblob(16))),
    -- 记录创建的时间
    created_at DATETIME NOT NULL,
    -- 记录最后更新的时间
    last_updated_at DATETIME NOT NULL,
    -- 若该子查询类型被删除，记录删除的时间，为空则表示未删除
    deleted_at DATETIME,
    -- 子查询类型的名称
    name TEXT,
    -- 子查询类型的描述
    description TEXT,
    -- 标识是否是用户自定义的子查询类型，非用户自定义不可修改
    is_customized BOOLEAN CHECK(is_customized IN (0, 1))
);

-- 创建触发器，检查子查询类型名称长度
CREATE TRIGGER check_name_length BEFORE INSERT ON t_sub_query_type
BEGIN
    SELECT CASE WHEN LENGTH(NEW.name) > 8 THEN
        RAISE(ABORT, 'Name exceeds 8 characters')
    END;
END;