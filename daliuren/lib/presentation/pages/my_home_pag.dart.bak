        Text(daLiuPan.threeChuan.nineZongMen.name,style: eightSeasonTextStyle.copyWith(fontSize: 32,fontWeight: FontWeight.w700,color: Colors.blueGrey.shade800),),
        classTypeList.isEmpty?Text(""):RichText(
        strutStyle: StrutStyle(height: 1),
            text: TextSpan(
              style: TextStyle(fontWeight: FontWeight.w300,fontSize: 16,color: Colors.black.withOpacity(.8)),
